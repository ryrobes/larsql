# LARS All-in-One
# Single container with LARS + ClickHouse for easy demo/testing
#
# USAGE:
#   docker build -f Dockerfile.aio -t lars-aio .
#   docker run -it \
#     -e OPENROUTER_API_KEY=sk-or-... \
#     -v $(pwd)/my-project:/workspace \
#     -p 5432:5432 \
#     -p 5050:5050 \
#     lars-aio
#
# The /workspace mount should contain your cascades, sql_connections, etc.
# On first run, if /workspace is empty, it will be initialized with starter files.

FROM python:3.11-slim

# Install system dependencies + ClickHouse + supervisor
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Supervisor for multi-process
    supervisor \
    # ClickHouse repo setup
    apt-transport-https \
    ca-certificates \
    curl \
    dirmngr \
    gnupg \
    # Playwright browser dependencies
    wget \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    xdg-utils \
    libwoff1 \
    libharfbuzz-icu0 \
    libvpx7 \
    # FFmpeg for video/audio processing
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install ClickHouse
RUN curl -fsSL https://packages.clickhouse.com/rpm/lts/repodata/repomd.xml.key | gpg --dearmor -o /usr/share/keyrings/clickhouse-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/clickhouse-keyring.gpg] https://packages.clickhouse.com/deb stable main" > /etc/apt/sources.list.d/clickhouse.list \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        clickhouse-server \
        clickhouse-client \
    && rm -rf /var/lib/apt/lists/*

# Install LARS from PyPI with browser support
RUN pip install --no-cache-dir "larsql[browser]"

# Install Playwright browsers
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN playwright install chromium && playwright install-deps chromium

# Create directories
RUN mkdir -p \
    /var/lib/clickhouse \
    /var/log/clickhouse-server \
    /var/log/supervisor \
    /workspace

# ClickHouse config: conservative memory settings for shared container
RUN mkdir -p /etc/clickhouse-server/config.d && \
    echo '<clickhouse>\n\
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>\n\
    <max_concurrent_queries>20</max_concurrent_queries>\n\
    <listen_host>127.0.0.1</listen_host>\n\
</clickhouse>' > /etc/clickhouse-server/config.d/memory.xml

# Supervisor config
COPY <<'EOF' /etc/supervisor/conf.d/lars.conf
[supervisord]
nodaemon=true
user=root
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid

[program:clickhouse]
command=/usr/bin/clickhouse-server --config-file=/etc/clickhouse-server/config.xml
user=clickhouse
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/clickhouse.log
stderr_logfile=/var/log/supervisor/clickhouse-err.log
priority=10

[program:lars-sql]
command=lars serve sql --host 0.0.0.0 --port 5432
directory=/workspace
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/lars-sql.log
stderr_logfile=/var/log/supervisor/lars-sql-err.log
startsecs=5
startretries=10
priority=20

[program:lars-studio]
command=lars serve studio --host 0.0.0.0 --port 5050 --workers 4
directory=/workspace
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/lars-studio.log
stderr_logfile=/var/log/supervisor/lars-studio-err.log
startsecs=5
startretries=10
priority=20
EOF

# Entrypoint script
COPY <<'ENTRY' /entrypoint.sh
#!/bin/bash
set -e

# Validate required env
if [ -z "$OPENROUTER_API_KEY" ]; then
    echo "=============================================="
    echo "ERROR: OPENROUTER_API_KEY is required"
    echo "=============================================="
    echo ""
    echo "Get a key at: https://openrouter.ai/keys"
    echo ""
    echo "Usage:"
    echo "  docker run -e OPENROUTER_API_KEY=sk-or-... lars-aio"
    echo ""
    exit 1
fi

# Ensure ClickHouse data dir has correct permissions
chown -R clickhouse:clickhouse /var/lib/clickhouse /var/log/clickhouse-server

# Start ClickHouse in background for init
echo "Starting ClickHouse..."
su -s /bin/bash clickhouse -c "/usr/bin/clickhouse-server --config-file=/etc/clickhouse-server/config.xml &"

# Wait for ClickHouse to be ready
echo "Waiting for ClickHouse..."
for i in {1..30}; do
    if clickhouse-client --query "SELECT 1" &>/dev/null; then
        echo "ClickHouse ready."
        break
    fi
    sleep 1
done

# Initialize workspace if empty (no .lars marker)
if [ ! -f "/workspace/.lars" ]; then
    echo ""
    echo "Initializing workspace..."
    lars init /workspace --force
    echo ""
fi

# Initialize database schema and models
echo "Initializing database..."
cd /workspace && lars db init
echo ""

# Stop background ClickHouse (supervisor will restart it properly)
pkill -f clickhouse-server || true
sleep 2

echo "=============================================="
echo "LARS All-in-One Starting"
echo "=============================================="
echo ""
echo "  SQL Server: localhost:5432 (psql, DBeaver, etc.)"
echo "  Studio:     http://localhost:5050"
echo "  Workspace:  /workspace"
echo ""
echo "=============================================="
echo ""

exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
ENTRY
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

# Environment defaults
ENV LARS_USE_CLICKHOUSE_SERVER=true
ENV LARS_CLICKHOUSE_HOST=127.0.0.1
ENV LARS_CLICKHOUSE_PORT=9000
ENV LARS_CLICKHOUSE_DATABASE=lars

# Expose ports
EXPOSE 5432 5050

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD clickhouse-client --query "SELECT 1" && curl -f http://localhost:5050/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
